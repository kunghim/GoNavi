# gonavi-scan 本机测试连接模板。复制为 connections.local.yaml 后填写真实凭据。
version: 1
credentials:
  standard:
    username: dbx_test
    password: REPLACE_ME
  no_auth:
    username: ""
    password: ""
instances:
